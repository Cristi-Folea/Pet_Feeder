  ArduinoCloud.printDebugInfo();
  data[0] = 'H';
  data[2] = '\0';
}

void loop() {
  ArduinoCloud.update();
  // Your code here 
  bool e_timpul_de_masa = feed_schedule1.isActive() || feed_schedule2.isActive() || feed_schedule3.isActive();

  if( e_timpul_de_masa){

    if(!comanda_trimisa_deja){
      sendSignalFeeder();
      comanda_trimisa_deja = true;
    } 
  }
    else {
      comanda_trimisa_deja = false;
  }
}


